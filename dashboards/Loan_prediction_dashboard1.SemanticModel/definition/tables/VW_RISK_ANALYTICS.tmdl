table VW_RISK_ANALYTICS
	lineageTag: e5b130f4-bd5e-4687-8eeb-2f9b72f4bf33

	measure 'Total Loans' = DISTINCTCOUNT(VW_RISK_ANALYTICS[LOAN_ID])
		formatString: 0
		lineageTag: 7495bbaa-aec7-4369-a202-a9fabb691440

	measure 'Default Rate' =
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT(VW_RISK_ANALYTICS[LOAN_ID]),
			        VW_RISK_ANALYTICS[LOAN_STATUS] = 1
			    ),
			    [Total Loans]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a0a7ac9d-fff2-4426-9202-253f86be18a7

	measure 'Average Default Probability' = AVERAGE(VW_RISK_ANALYTICS[DEFAULT_PROB])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4df14323-58c4-4d77-8149-2061f78216d8

	measure 'High Risk Loans' =
			
			CALCULATE(
			    DISTINCTCOUNT(VW_RISK_ANALYTICS[LOAN_ID]),
			    VW_RISK_ANALYTICS[RISK_TIER] = "HIGH"
			)
		formatString: 0
		lineageTag: 8c33b304-182e-4107-851b-9bd8eec40476

	measure 'Very High Risk Loans' =
			
			CALCULATE(
			    DISTINCTCOUNT(VW_RISK_ANALYTICS[LOAN_ID]),
			    VW_RISK_ANALYTICS[RISK_TIER] = "VERY_HIGH"
			)
		formatString: 0
		lineageTag: 744277c5-8200-4182-9819-9940cf2c2d82

	measure 'Total Loan Amount' = SUM(VW_RISK_ANALYTICS[LOAN_AMNT])
		formatString: #,0
		lineageTag: 9d7c2e2b-2c7a-4a5e-8e2b-0b8b7e3f0001

	measure 'Average Loan Amount' = AVERAGE(VW_RISK_ANALYTICS[LOAN_AMNT])
		formatString: #,0
		lineageTag: 9d7c2e2b-2c7a-4a5e-8e2b-0b8b7e3f0002

	measure 'Average Interest Rate' = AVERAGE(VW_RISK_ANALYTICS[LOAN_INT_RATE])
		formatString: 0.0%
		lineageTag: 9d7c2e2b-2c7a-4a5e-8e2b-0b8b7e3f0003

	measure 'Defaulted Loans' = CALCULATE(DISTINCTCOUNT(VW_RISK_ANALYTICS[LOAN_ID]), VW_RISK_ANALYTICS[LOAN_STATUS] = 1)
		formatString: 0
		lineageTag: 9d7c2e2b-2c7a-4a5e-8e2b-0b8b7e3f0004

	measure 'Low Medium Risk Loans' = CALCULATE(DISTINCTCOUNT(VW_RISK_ANALYTICS[LOAN_ID]), VW_RISK_ANALYTICS[RISK_TIER] IN {"LOW", "MEDIUM"})
		formatString: 0
		lineageTag: 9d7c2e2b-2c7a-4a5e-8e2b-0b8b7e3f0005

	measure 'Non-Defaulted Loans' =
			CALCULATE(
			    [Total Loans],
			    VW_RISK_ANALYTICS[LOAN_STATUS] = 0
			)
		formatString: 0
		lineageTag: 44a18e09-71b0-427d-a5ce-ed9dd9e91797

	measure 'High Plus Very High Risk' = [High Risk Loans] + [Very High Risk Loans]
		formatString: 0
		lineageTag: 6c36e0e9-4941-4ae2-b83c-5c78ebfe42a2

	measure 'Default Exposure' =
			CALCULATE(
			    [Total Loan Amount],
			    VW_RISK_ANALYTICS[LOAN_STATUS] = 1
			)
		formatString: #,0
		lineageTag: 97dd446b-f20c-4348-9b92-9f9fe70105ab

	measure 'Average Loan Income Ratio' = AVERAGE(VW_RISK_ANALYTICS[LOAN_PERCENT_INCOME])
		formatString: 0.00%
		lineageTag: a27b2dfa-6679-494b-acdd-2f51f7031585

	measure 'Observed Default Rate' =
			DIVIDE(
			    [Defaulted Loans],
			    [Total Loans],
			    0
			)
		formatString: 0.00%
		lineageTag: 58b98910-e443-4b24-86f0-bbfc5f5647cb

	measure 'Average Age' = AVERAGE(VW_RISK_ANALYTICS[PERSON_AGE])
		formatString: 0.0
		lineageTag: 04fbf4a3-7ee2-403c-ab05-b163b255184c

	measure 'Average Income' = AVERAGE(VW_RISK_ANALYTICS[PERSON_INCOME])
		formatString: #,0
		lineageTag: bc68de34-482d-457e-8b7e-8717cf886da9

	measure 'Average Employment Length' = AVERAGE(VW_RISK_ANALYTICS[PERSON_EMP_LENGTH])
		formatString: 0.0
		lineageTag: 968d1e03-ea93-4e7f-8ff8-f3ac552ffd34

	measure 'Average Credit History Length' = AVERAGE(VW_RISK_ANALYTICS[CB_PERSON_CRED_HIST_LENGTH])
		formatString: 0.0
		lineageTag: 2bd60b78-2120-4a5e-b991-09ac9539401a

	measure 'Total Borrowers' = DISTINCTCOUNT(VW_RISK_ANALYTICS[BORROWER_ID])
		formatString: 0
		lineageTag: c1a2e3f4-1a2b-4c3d-9e8f-1a2b3c4d5e01

	measure 'Loans per Borrower' = DIVIDE([Total Loans], [Total Borrowers], 0)
		formatString: 0.00
		lineageTag: c1a2e3f4-1a2b-4c3d-9e8f-1a2b3c4d5e02

	measure 'High Risk Share' = DIVIDE([High Plus Very High Risk], [Total Loans], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c1a2e3f4-1a2b-4c3d-9e8f-1a2b3c4d5e03

	measure 'Prior Default Rate' =
			DIVIDE(
			    CALCULATE([Total Loans], VW_RISK_ANALYTICS[CB_PERSON_DEFAULT_ON_FILE] = "Y"),
			    [Total Loans],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c1a2e3f4-1a2b-4c3d-9e8f-1a2b3c4d5e04

	measure 'Model Calibration Gap' = [Average Default Probability] - [Observed Default Rate]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c1a2e3f4-1a2b-4c3d-9e8f-1a2b3c4d5e05

	measure 'Total Interest Exposure' = SUMX(VW_RISK_ANALYTICS, VW_RISK_ANALYTICS[LOAN_AMNT] * VW_RISK_ANALYTICS[LOAN_INT_RATE])
		formatString: #,0
		lineageTag: c1a2e3f4-1a2b-4c3d-9e8f-1a2b3c4d5e06

	measure 'Latest Model Version' = CALCULATE(MAX(VW_RISK_ANALYTICS[MODEL_VERSION]))
		lineageTag: c1a2e3f4-1a2b-4c3d-9e8f-1a2b3c4d5e07

